@model Product

<h2 class="text-danger">Delete Product</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this product?
</div>

<ul class="list-group mb-3">
    <li class="list-group-item"><strong>Name:</strong> @Model.Name</li>
    <li class="list-group-item"><strong>Price:</strong> @Model.Price</li>
    <li class="list-group-item"><strong>Quantity:</strong> @Model.Quantity</li>
</ul>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>